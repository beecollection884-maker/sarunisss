# Stage 1: Build frontend assets
FROM node:20-alpine AS frontend
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: All-in-one Laravel + MariaDB image for local/demo use
FROM php:8.3-cli-alpine

RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://dl-4.alpinelinux.org/alpine#g' /etc/apk/repositories

RUN apk add --no-cache \
    bash \
    curl \
    freetype-dev \
    git \
    icu-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    libxml2-dev \
    libzip-dev \
    mariadb \
    mariadb-client \
    oniguruma-dev \
    shadow \
    su-exec \
    unzip \
    zip

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    intl \
    opcache

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www
COPY . /var/www
COPY --from=frontend /app/public/build /var/www/public/build

RUN composer install --no-dev --optimize-autoloader --no-interaction \
    && mkdir -p /run/mysqld /var/lib/mysql \
    && chown -R mysql:mysql /run/mysqld /var/lib/mysql \
    && sed -i 's/\r$//' /var/www/docker/all-in-one-entrypoint.sh \
    && chmod +x /var/www/docker/all-in-one-entrypoint.sh \
    && chown -R www-data:www-data /var/www \
    && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

ENV APP_NAME="SMP IP YAKIN" \
    APP_ENV=local \
    APP_DEBUG=true \
    APP_URL=http://localhost:8000 \
    DB_CONNECTION=mysql \
    DB_HOST=127.0.0.1 \
    DB_PORT=3306 \
    DB_DATABASE=sarunis \
    DB_USERNAME=root \
    DB_PASSWORD=rootpassword \
    MYSQL_ROOT_PASSWORD=rootpassword \
    INITIAL_ADMIN_EMAIL=admin@sarunis.test \
    INITIAL_ADMIN_PASSWORD=password \
    INITIAL_ADMIN_SYNC_PASSWORD=false

EXPOSE 8000

ENTRYPOINT ["/var/www/docker/all-in-one-entrypoint.sh"]
