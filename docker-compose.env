# Docker Compose environment overrides for local development
# Copy this file to docker-compose.override.env and set values there.

# Laravel app
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
DB_PASSWORD=

# Import defaults
# This password is used only for imported CSV accounts.
# It should be set in the environment, not committed to version control.
IMPORT_DEFAULT_PASSWORD=

# MariaDB
MYSQL_ROOT_PASSWORD=
